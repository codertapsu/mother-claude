#!/bin/sh
# Mother Claude wake listener. Generated by the Mother Claude desktop app; do
# not edit (it is rewritten on every start).
#
#   mc-wake        (exec-form Stop hook with "asyncRewake": true)
#
# Long-polls the Mother Claude app while the Claude Code process that ran it
# ($PPID) is alive. When the app hands back a message sent from the phone it
# prints it on stderr and exits 2, which wakes the idle session with it. Every
# other ending is a silent exit 0.

MC_DATA='@MC_DATA@'

mc_quiet() {
    cat >/dev/null 2>&1
    exit 0
}

[ "${MOTHER_CLAUDE_OWNED:-}" = 1 ] && mc_quiet
[ -d "$MC_DATA" ] || MC_DATA="${CLAUDE_PLUGIN_ROOT:-/nonexistent}/../.."
command -v curl >/dev/null 2>&1 || mc_quiet
case "${PPID:-}" in
    '' | 0 | 1 | *[!0-9]*) mc_quiet ;;
esac
case "${MC_WAKE_RETRY_SECS:-}" in
    '' | *[!0-9]*) retry=15 ;;
    *) retry=$MC_WAKE_RETRY_SECS ;;
esac

payload=$(cat)

while kill -0 "$PPID" 2>/dev/null; do
    [ -f "$MC_DATA/hook.disabled" ] && exit 0
    [ -r "$MC_DATA/hook.curlrc" ] && [ -r "$MC_DATA/hook.base" ] || exit 0
    base=$(head -n 1 "$MC_DATA/hook.base" 2>/dev/null)
    case "$base" in
        http://127.0.0.1:*) ;;
        *) exit 0 ;;
    esac
    case "${base#http://127.0.0.1:}" in
        '' | *[!0-9]*) exit 0 ;;
    esac
    # The status code is the last line; the curl config is re-read every
    # time, so a rotated token heals by itself.
    r=$(printf '%s' "$payload" | curl -q --noproxy '*' -sS --max-time 55 \
        -K "$MC_DATA/hook.curlrc" -H 'Content-Type: application/json' \
        -H "X-MC-Pid: $PPID" --data-binary @- -w '\n%{http_code}' \
        "$base/hooks/wait?pid=$PPID" 2>/dev/null)
    code=$(printf '%s\n' "$r" | tail -n 1)
    case "$code" in
        200)
            printf '%s\n' "$r" | sed '$d' >&2
            exit 2
            ;;
        204) ;;
        409 | 410) exit 0 ;;
        *) sleep "$retry" ;;
    esac
done
exit 0
