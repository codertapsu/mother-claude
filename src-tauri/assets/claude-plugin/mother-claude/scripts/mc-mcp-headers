#!/bin/sh
# Mother Claude MCP headers helper. Generated by the Mother Claude desktop
# app; do not edit (it is rewritten on every start).
#
#   mc-mcp-headers        (the "headersHelper" of the plugin's .mcp.json)
#
# Prints the headers Claude Code sends to Mother Claude's MCP server, as one
# JSON object: the MCP token from the app's data dir, the Claude Code process
# that runs this helper ($PPID: the CLI starts it itself) and, in a session
# Mother Claude launched, that session's id. Claude Code runs it once per
# connection and again after a 401, so a token the app replaced at its last
# start heals by itself. It always exits 0; with nothing to send it prints {}
# (the server then answers 401). The token is printed to Claude Code only.

MC_DATA='@MC_DATA@'

[ -d "$MC_DATA" ] || MC_DATA="${CLAUDE_PLUGIN_ROOT:-/nonexistent}/../.."

token=''
if [ -r "$MC_DATA/mcp.token" ]; then
    token=$(head -n 1 "$MC_DATA/mcp.token" 2>/dev/null)
fi
case "$token" in
    mcm_*) ;;
    *) token='' ;;
esac
case "${token#mcm_}" in
    '' | *[!A-Za-z0-9_-]*) token='' ;;
esac

pid=${PPID:-}
case "$pid" in
    '' | 0 | 1 | *[!0-9]*) pid='' ;;
esac

# Only a session Mother Claude launched names itself (it set both variables).
session=''
if [ "${MOTHER_CLAUDE_OWNED:-}" = 1 ]; then
    session=${MOTHER_CLAUDE_SESSION:-}
    case "$session" in
        ????????-????-????-????-????????????) ;;
        *) session='' ;;
    esac
    case "$session" in
        *[!0-9a-f-]*) session='' ;;
    esac
fi

out=''
if [ -n "$token" ]; then
    out="\"Authorization\":\"Bearer $token\""
fi
if [ -n "$pid" ]; then
    out="$out${out:+,}\"X-MC-Pid\":\"$pid\""
fi
if [ -n "$session" ]; then
    out="$out${out:+,}\"X-MC-Session\":\"$session\""
fi
printf '{%s}\n' "$out"
exit 0
