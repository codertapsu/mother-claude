#!/bin/sh
# Mother Claude foreign-control hook helper. Generated by the Mother Claude
# desktop app; do not edit (it is rewritten on every start).
#
#   mc-hook <event> <max-seconds> <observe|decide>     (exec-form hook)
#
# Forwards the hook payload on stdin to the Mother Claude app over loopback.
# In "decide" mode it prints the app's JSON answer. It never fails the hook:
# whatever happens (app closed, token rotated, control turned off) it exits 0,
# and it prints nothing unless the app answered with a 2xx.

MC_DATA='@MC_DATA@'

mc_quiet() {
    cat >/dev/null 2>&1
    exit 0
}

# Sessions Mother Claude runs itself report through their own channel.
[ "${MOTHER_CLAUDE_OWNED:-}" = 1 ] && mc_quiet
[ -d "$MC_DATA" ] || MC_DATA="${CLAUDE_PLUGIN_ROOT:-/nonexistent}/../.."
[ -f "$MC_DATA/hook.disabled" ] && mc_quiet
[ -r "$MC_DATA/hook.curlrc" ] && [ -r "$MC_DATA/hook.base" ] || mc_quiet
command -v curl >/dev/null 2>&1 || mc_quiet

base=$(head -n 1 "$MC_DATA/hook.base" 2>/dev/null)
case "$base" in
    http://127.0.0.1:*) ;;
    *) mc_quiet ;;
esac
case "${base#http://127.0.0.1:}" in
    '' | *[!0-9]*) mc_quiet ;;
esac
case "${2:-}" in
    '' | *[!0-9]*) max=2 ;;
    *) max=$2 ;;
esac

# A session run with a long-lived token (a Mother Claude token account):
# send only the token's SHA-256, so the app can tell which account it is. The
# token itself never leaves this process tree (printf is a shell builtin).
acct=''
if [ -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]; then
    if command -v openssl >/dev/null 2>&1; then
        acct=$(printf '%s' "$CLAUDE_CODE_OAUTH_TOKEN" | openssl dgst -sha256 -r 2>/dev/null)
    elif command -v sha256sum >/dev/null 2>&1; then
        acct=$(printf '%s' "$CLAUDE_CODE_OAUTH_TOKEN" | sha256sum 2>/dev/null)
    elif command -v shasum >/dev/null 2>&1; then
        acct=$(printf '%s' "$CLAUDE_CODE_OAUTH_TOKEN" | shasum -a 256 2>/dev/null)
    fi
    acct=$(printf '%s' "$acct" | cut -c1-64)
    case "$acct" in
        *[!0-9a-f]* | '') acct='' ;;
    esac
fi

# -q must come first: never read ~/.curlrc. No proxy: this is loopback.
out=$(curl -q --noproxy '*' -sf --max-time "$max" -K "$MC_DATA/hook.curlrc" \
    -H 'Content-Type: application/json' -H "X-MC-Pid: $PPID" \
    ${acct:+-H X-MC-Token-Sha256:$acct} \
    --data-binary @- "$base/hooks/event" 2>/dev/null) &&
    [ "${3:-observe}" != observe ] && printf '%s' "$out"
exit 0
