{
  "name": "mother-claude",
  "version": "0.11.0",
  "description": "One dashboard (desktop + phone) to monitor and control every local Claude Code session.",
  "private": true,
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "postbuild": "node scripts/check-csp.mjs",
    "check:csp": "node scripts/check-csp.mjs",
    "build:dev": "ng build --configuration development",
    "watch": "ng build --watch --configuration development",
    "test": "node scripts/test.mjs --watch=false",
    "test:release": "node --test scripts/release/release-tools.test.mjs",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\"",
    "i18n:check": "node scripts/i18n-check.mjs",
    "sidecar:install": "node scripts/sidecar-npm.mjs install",
    "sidecar:build": "node scripts/sidecar-npm.mjs install && node scripts/sidecar-npm.mjs run build",
    "sidecar:bundle": "node scripts/sidecar-npm.mjs install && node scripts/sidecar-npm.mjs run build && node scripts/sidecar-npm.mjs prune --omit=dev",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "ext:build": "node extension/build.mjs",
    "ext:build:firefox": "node extension/build.mjs --target firefox",
    "ext:watch": "node extension/build.mjs --watch",
    "ext:test": "node --test \"extension/test/unit/**/*.test.ts\"",
    "ext:e2e": "node extension/build.mjs --target chrome-e2e && node --test --test-concurrency=1 --test-timeout=600000 \"extension/test/e2e/**/*.e2e.ts\"",
    "ext:lint": "tsc -p extension/tsconfig.json && tsc -p extension/test/tsconfig.json && eslint extension && prettier --check \"extension/**/*.{ts,mjs,html,css,json,md}\""
  },
  "dependencies": {
    "@angular/common": "22.2.5",
    "@angular/compiler": "22.2.5",
    "@angular/core": "22.2.5",
    "@angular/forms": "22.2.5",
    "@angular/platform-browser": "22.2.5",
    "@angular/router": "22.2.5",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-process": "2.4.0",
    "@tauri-apps/plugin-updater": "2.14.1",
    "rxjs": "7.8.2",
    "tslib": "2.9.1",
    "zone.js": "0.16.3"
  },
  "devDependencies": {
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.5",
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/chrome": "0.3.7",
    "@types/node": "26.6.6",
    "@types/ws": "8.18.2",
    "@vitest/browser-playwright": "5.1.0",
    "angular-eslint": "22.6.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "happy-dom": "21.0.4",
    "playwright": "1.65.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0",
    "ws": "8.22.2"
  }
}
