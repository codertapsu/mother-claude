{
  "name": "mother-claude",
  "version": "0.4.0",
  "description": "One dashboard (desktop + phone) to monitor and control every local Claude Code session.",
  "private": true,
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "postbuild": "node scripts/check-csp.mjs",
    "check:csp": "node scripts/check-csp.mjs",
    "build:dev": "ng build --configuration development",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false --browsers=ChromeHeadless",
    "test:release": "node --test scripts/release/release-tools.test.mjs",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\"",
    "sidecar:install": "node scripts/sidecar-npm.mjs install",
    "sidecar:build": "node scripts/sidecar-npm.mjs install && node scripts/sidecar-npm.mjs run build",
    "sidecar:bundle": "node scripts/sidecar-npm.mjs install && node scripts/sidecar-npm.mjs run build && node scripts/sidecar-npm.mjs prune --omit=dev",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@angular/common": "22.2.0",
    "@angular/compiler": "22.2.0",
    "@angular/core": "22.2.0",
    "@angular/forms": "22.2.0",
    "@angular/platform-browser": "22.2.0",
    "@angular/router": "22.2.0",
    "@tauri-apps/api": "2.12.0",
    "@tauri-apps/plugin-process": "2.4.0",
    "@tauri-apps/plugin-updater": "2.13.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.16.3"
  },
  "devDependencies": {
    "@angular/build": "22.2.0",
    "@angular/cli": "22.2.0",
    "@angular/compiler-cli": "22.2.0",
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.12.0",
    "@types/jasmine": "6.0.0",
    "angular-eslint": "22.5.0",
    "eslint": "10.11.0",
    "jasmine-core": "6.3.0",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.1",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.3.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
