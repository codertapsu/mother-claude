# Apple Developer ID credentials for the macOS release leg,
# scripts/release/release-macos.sh.
#
#   cp scripts/apple-credentials.env.example scripts/apple-credentials.env
#   # fill in your values
#   source scripts/apple-credentials.env
#   RELEASE_TAG=v0.4.0 bash scripts/release/release-macos.sh
#
# The filled-in file is git-ignored (.gitignore: scripts/apple-credentials.env).
# Never commit it, and never paste these values into a chat, an issue, or a
# commit message.
#
# APPLE_PASSWORD is an APP-SPECIFIC password — appleid.apple.com -> Sign-In and
# Security -> App-Specific Passwords. It is NOT your Apple ID password. Apple
# rejects the account password here, and a real one in a shell history is a
# credential you then have to rotate.
#
# The signing certificate itself is NOT here: it lives in your login keychain.
# Check what you have with:
#
#   security find-identity -v -p codesigning
#
# It must be a "Developer ID Application" certificate. An "Apple Development"
# certificate builds fine and then fails notarization, which is a slow way to
# find out.

# Exactly as printed by `security find-identity`, including the team in parens.
export APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID1234)"

# The Apple ID used for notarization.
export APPLE_ID="you@example.com"

# App-specific password for that Apple ID (format: xxxx-xxxx-xxxx-xxxx).
export APPLE_PASSWORD="xxxx-xxxx-xxxx-xxxx"

# Your 10-character Apple Team ID.
export APPLE_TEAM_ID="TEAMID1234"
